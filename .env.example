# External PostgreSQL over Tailscale
DB_HOST=100.113.124.33
DB_PORT=6970
DB_NAME=fakebook
DB_USER=fakebook
DB_PASSWORD=replace-me

# Runtime database roles. Keep DB_USER/DB_PASSWORD only for owner-run migrations;
# scripts/provision-database-roles.ps1 generates the passwords without printing them.
AUTH_DB_USER=fakebook_auth
AUTH_DB_PASSWORD=replace-with-at-least-32-random-bytes
SOCIALGRAPH_DB_USER=fakebook_social_graph
SOCIALGRAPH_DB_PASSWORD=replace-with-at-least-32-random-bytes
RECOMMENDATION_DB_USER=fakebook_recommendation
RECOMMENDATION_DB_PASSWORD=replace-with-at-least-32-random-bytes
SEARCH_DB_USER=fakebook_search
SEARCH_DB_PASSWORD=replace-with-at-least-32-random-bytes
NOTIFICATION_DB_USER=fakebook_notification
NOTIFICATION_DB_PASSWORD=replace-with-at-least-32-random-bytes
MESSENGER_DB_USER=fakebook_messenger
MESSENGER_DB_PASSWORD=replace-with-at-least-32-random-bytes
PAYMENT_DB_USER=fakebook_payment
PAYMENT_DB_PASSWORD=replace-with-at-least-32-random-bytes

# Host-mode SocialGraph Redis. Docker Compose overrides this with its private Redis DNS.
REDIS_CONNECTION_STRING=127.0.0.1:6379,abortConnect=false,connectTimeout=500,syncTimeout=1000

# Browser/session signing. The private PKCS#8 DER key belongs only to Authentication;
# Gateway and Upload receive the SubjectPublicKeyInfo DER public key.
JWT_PRIVATE_KEY_BASE64=generate-with-scripts-initialize-secrets
JWT_PUBLIC_KEY_BASE64=generate-with-scripts-initialize-secrets
JWT_KEY_ID=fakebook-rs256-yyyyMMdd-fingerprint
# Leave empty after the maximum old access-token TTL has elapsed.
JWT_LEGACY_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
AUTH_ABSOLUTE_SESSION_DAYS=90

# Legacy compatibility key. Managed startup still requires every dedicated key
# below to be present and distinct; docker-compose no longer falls back to this.
GATEWAY_SHARED_SECRET=replace-with-at-least-32-random-bytes
AUTH_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
SOCIALGRAPH_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
RECOMMENDATION_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
SEARCH_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
NOTIFICATION_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
MESSENGER_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
PAYMENT_GATEWAY_SECRET=replace-with-at-least-32-random-bytes

# REST service-to-service target credentials
AUTHENTICATION_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
SOCIALGRAPH_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
SOCIALGRAPH_OUTBOX_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
RECOMMENDATION_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
SEARCH_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
NOTIFICATION_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
MESSENGER_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
UPLOAD_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
PAYMENT_AUTH_SECRET=replace-with-at-least-32-random-bytes

# Production deployment. PUBLIC_ORIGIN is the HTTPS origin exposed by your own
# reverse proxy; the Compose edge itself stays on loopback by default.
PUBLIC_ORIGIN=https://fakebook.example.com
MEDIA_HOST=fakebook.example.com
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080

# Prebuilt application images used by docker-compose.yaml. Pin this to an immutable
# release/commit tag for production after the first verified deployment.
FAKEBOOK_IMAGE_TAG=main

# Optional Gateway runtime transport overrides. These defaults match the bridge-network
# topology in docker-compose.yaml. A shared-network-namespace deployment should use
# 127.0.0.1 with the same canonical ports instead.
GATEWAY_AUTHENTICATION_SUBGRAPH_URL=http://authentication:1001/graphql
GATEWAY_SOCIALGRAPH_SUBGRAPH_URL=http://social-graph:1002/graphql
GATEWAY_RECOMMENDATION_SUBGRAPH_URL=http://recommendation:1003/graphql
GATEWAY_SEARCH_SUBGRAPH_URL=http://search:1004/graphql
GATEWAY_NOTIFICATION_SUBGRAPH_URL=http://notification:1005/graphql
GATEWAY_MESSAGING_SUBGRAPH_URL=http://messaging:1006/graphql
GATEWAY_PAYMENT_SUBGRAPH_URL=http://payment:1007/graphql
GATEWAY_PAYMENT_WEBHOOK_URL=http://payment:1007/internal/webhooks/payos

# Development-only browser origins.
TAILSCALE_ORIGIN=https://your-device.your-tailnet.ts.net:8443
LOCAL_FRONTEND_ORIGIN=http://localhost:3001

# Optional latency/load tuning. Defaults are already safe for host and Compose mode.
VITE_GRAPHQL_TIMEOUT_MS=20000
RECOMMENDATION_CONTENT_TIMEOUT_SECONDS=180
IntegrationOutbox__PollMilliseconds=500
IntegrationOutbox__MaxIdlePollMilliseconds=2000
NotificationDelivery__PollMilliseconds=250
NotificationDelivery__MaxIdlePollMilliseconds=2000
Messaging__OutboxPollMilliseconds=250
Messaging__OutboxMaxIdlePollMilliseconds=2000
AUTH_BCRYPT_WORK_FACTOR=11
AUTH_BCRYPT_MAX_CONCURRENCY=2
AUTH_BCRYPT_QUEUE_LIMIT=16
AUTH_BCRYPT_QUEUE_TIMEOUT_SECONDS=5

# Distributed tracing sample ratio (0..1). Metrics are exported without sampling.
OTEL_TRACE_SAMPLE_RATIO=0.1

# Authentication email delivery
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=disabled
SMTP_PASSWORD=disabled
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Fakebook

# PayOS remains disabled until real credentials and webhook routing are verified
PAYMENTS_ENABLED=false
# Production Compose only. Keep one authoritative deployment responsible for the PayOS webhook URL.
PAYOS_REGISTER_WEBHOOK_ON_STARTUP=true
PAYOS_CLIENT_ID=disabled
PAYOS_API_KEY=disabled
PAYOS_CHECKSUM_KEY=disabled

# Deterministic local/demo seed only; never reuse a real account password.
FAKEBOOK_DEMO_PASSWORD=
