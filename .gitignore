# Real secrets. Copy .env.example to .env and fill it in locally.
.env

# Host-mode runtime state: PIDs, logs, exported schemas, scratch build output.
.run/

# Checksum-verified third-party binaries fetched by scripts/bootstrap-tools.ps1.
.tools/

# Generated by seed-demo.ps1; contains ids from a specific database.
scripts/seed/*.receipt.json

# Each service is versioned in its own repository. This repository holds only the
# orchestration layer that ties them together; services.manifest.json records which
# commit of each service a given compose file was verified against.
/APIGateway/
/AuthenticationService/
/Frontend/
/MessengerService/
/NotificationService/
/PaymentService/
/RecommendationService/
/SearchService/
/SocialGraphService/
/UploadSever/

# .NET build output (scripts/Fakebook.Maintenance)
bin/
obj/

# Editor and OS noise
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
*.suo
Thumbs.db
